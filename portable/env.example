# Shiraz Smart Atlas — environment example (نسخه نمایشی؛ هیچ کلید واقعی در آن نیست)
# این فایل فقط الگو است. سامانه بدون هیچ‌کدام از این متغیرها کار می‌کند.

# پورت سرور (پیش‌فرض 3000)
PORT=3000

# مسیر پایگاه داده SQLite (لانچر به‌صورت خودکار تنظیم می‌کند)
DATABASE_URL=file:./app/db/custom.db

# سرویس دستیار هوشمند (اختیاری؛ بدون آن حالت بازیابی متنی فعال است)
# ZAI_API_KEY=
# ZAI_BASE_URL=

# موتورهای شبیه‌سازی (اختیاری؛ تا زمان پیکربندی، سامانه وضعیت صادقانه «پیکربندی‌نشده» نشان می‌دهد)
# ENERGYPLUS_EXE=C:\EnergyPlus\energyplus.exe
# LADYBUG_TOOL_PATH=
